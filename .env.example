# --- Développement local (PostgreSQL embarqué, npm run db:dev) ---
DATABASE_URL="postgresql://guanar:guanar@localhost:5432/guanar?schema=public"
DIRECT_URL="postgresql://guanar:guanar@localhost:5432/guanar?schema=public"

# --- Production Neon (remplacer en déploiement) ---
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-3.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-west-3.aws.neon.tech/neondb?sslmode=require"

# Clé de signature des sessions (obligatoire, longue et aléatoire en production)
AUTH_SECRET="change-moi-en-production-cle-longue-aleatoire"

# Protège /api/cron/recurring (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-moi"

# Stockage photos Vercel Blob (créé automatiquement lors de la connexion du store au projet)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Seed de production (npm run db:seed:prod) : aucun compte de démonstration
# ADMIN_PHONE="+221770000000"
# ADMIN_PIN="1234"
# ADMIN_NAME="Administrateur Guanar"
